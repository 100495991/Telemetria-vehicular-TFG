# =============================================================================
# Configuracion del stack CloudServices (copiar a .env y ajustar)
# =============================================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=cambia_esto
MYSQL_DATABASE=cambia_esto
MYSQL_USER=cambia_esto
MYSQL_PASSWORD=cambia_esto
# Puerto expuesto en el host para conectar con un cliente MySQL (Workbench, etc.)
MYSQL_HOST_PORT=3306

# --- Mosquitto (broker MQTT) ---
# Broker al que se SUSCRIBE el ingestor: el mosquitto privado de este docker
# (nombre de servicio en la red de compose).
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883

# Puerto en el que el contenedor mosquitto local escucha
MQTT_HOST_PORT=1883
# Topics (deben coincidir con los #define del firmware en gprs.h)
MQTT_TOPIC=uc3m/tfg/telemetria
MQTT_TOPIC_CABECERA=uc3m/tfg/telemetria/cabecera
MQTT_USER=cambia_esto
MQTT_PASSWORD=cambia_esto

# --- Web dashboard ---
# Puerto del navegador: http://localhost:<WEB_HOST_PORT>
WEB_HOST_PORT=8080
WEB_HOST_USERNAME=cambia_esto
WEB_HOST_PASSWORD=cambia_esto

# API key de CARTO para el basemap del mapa (obligatoria desde 2023).
# Solicitar en https://carto.com/basemaps/apikey -- gratis hasta 5M teselas/mes.
CARTO_API_KEY=cambia_esto